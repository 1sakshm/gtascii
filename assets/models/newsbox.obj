v  0.225 0.00 -0.20
v  0.225 0.95 -0.20
v -0.225 0.95 -0.20
v -0.225 0.00  0.20
v  0.225 0.00  0.20
v  0.225 0.95  0.20
v -0.225 0.95  0.20

# window panel on the front (+Z), slightly proud of the body
v -0.17 0.55 0.205
v  0.17 0.55 0.205
v  0.17 0.85 0.205
v -0.17 0.85 0.205

# sloped lid
v -0.24 0.95 -0.22
v  0.24 0.95 -0.22
